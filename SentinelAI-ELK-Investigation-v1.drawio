<mxfile host="app.diagrams.net" agent="Codex">
  <diagram id="sentinelai-elk-investigation-v1" name="SentinelAI ELK Investigation v1">
    <mxGraphModel dx="958" dy="525" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="zone-ui" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=20;fontSize=12;fontStyle=1;verticalAlign=top;" value="React UI (Browser)" vertex="1">
          <mxGeometry height="870" width="220" x="50" y="20" as="geometry" />
        </mxCell>
        <mxCell id="zone-core" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=20;fontSize=12;fontStyle=1;verticalAlign=top;" value="SentinelAI-Core  (Spring Boot :8080)" vertex="1">
          <mxGeometry height="870" width="640" x="270" y="20" as="geometry" />
        </mxCell>
        <mxCell id="zone-engine" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;opacity=20;fontSize=12;fontStyle=1;verticalAlign=top;" value="SentinelAI-Engine  (FastAPI :8000)" vertex="1">
          <mxGeometry height="420" width="340" x="940" y="20" as="geometry" />
        </mxCell>
        <mxCell id="zone-ext" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=20;fontSize=12;fontStyle=1;verticalAlign=top;" value="External Services" vertex="1">
          <mxGeometry height="430" width="340" x="940" y="460" as="geometry" />
        </mxCell>
        <mxCell id="ui-form" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="ElkInvestigationPage&#xa;────────────────&#xa;Inputs:&#xa;• Service Name&#xa;• Severity (ERROR/WARN/INFO/DEBUG)&#xa;• Time Range (15 min – 24 hr)&#xa;&#xa;[Investigate] button" vertex="1">
          <mxGeometry height="200" width="180" x="40" y="70" as="geometry" />
        </mxCell>
        <mxCell id="ui-result" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Investigation Results&#xa;────────────────&#xa;• Summary card&#xa;• Key Findings card&#xa;  (rootCause / impactedService&#xa;   / recommendedAction)&#xa;• Suspicious Logs card&#xa;  (monospace, red-tinted)" vertex="1">
          <mxGeometry height="220" width="180" x="40" y="610" as="geometry" />
        </mxCell>
        <mxCell id="ctrl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" value="ElkInvestigationController&#xa;────────────────&#xa;POST /api/elk-investigation/search&#xa;@Valid ElkInvestigationRequest&#xa;(service, severity, timeframeMinutes)" vertex="1">
          <mxGeometry height="100" width="260" x="310" y="70" as="geometry" />
        </mxCell>
        <mxCell id="svc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" value="ElkInvestigationServiceImpl  (Orchestrator)&#xa;────────────────────────────────&#xa;① Feature guard (elk.enabled?)&#xa;② Fetch logs  →  ElkClient&#xa;③ Build prompt  →  ElkPromptBuilder&#xa;④ Call AI  →  PythonAiMlService&#xa;⑤ Parse response  →  ElkResponseParser" vertex="1">
          <mxGeometry height="130" width="590" x="290" y="250" as="geometry" />
        </mxCell>
        <mxCell id="elk-client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" value="ElkClient&#xa;────────────────&#xa;ES BoolQuery:&#xa;  term(service)&#xa;  term(severity uppercase)&#xa;  range(timestamp, gte: now-Xm)&#xa;Sorted DESC · max 50 lines&#xa;Truncates lines &gt; 500 chars" vertex="1">
          <mxGeometry height="180" width="250" x="290" y="470" as="geometry" />
        </mxCell>
        <mxCell id="prompt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" value="ElkPromptBuilder&#xa;────────────────&#xa;Deduplicates via LinkedHashSet&#xa;Numbers each log line&#xa;Builds structured prompt:&#xa;  → JSON keys requested:&#xa;    issue / rootCause /&#xa;    impactedService / recommendedFix /&#xa;    suspiciousLogs (max 5)" vertex="1">
          <mxGeometry height="180" width="250" x="580" y="470" as="geometry" />
        </mxCell>
        <mxCell id="ai-svc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" value="PythonAiMlService&#xa;────────────────&#xa;WebClient POST /analyze&#xa;?provider=groq&#xa;body: { prompt: &quot;...&quot; }&#xa;Timeout: 60 s" vertex="1">
          <mxGeometry height="120" width="250" x="580" y="700" as="geometry" />
        </mxCell>
        <mxCell id="parser" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" value="ElkResponseParser&#xa;────────────────&#xa;Strips markdown fences&#xa;Parses JSON response&#xa;Maps fields:&#xa;  issue → summary&#xa;  rootCause → probableRootCause&#xa;  recommendedFix → recommendedAction&#xa;Falls back to plain text" vertex="1">
          <mxGeometry height="160" width="250" x="290" y="700" as="geometry" />
        </mxCell>
        <mxCell id="props" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="ElkProperties  (@ConfigurationProperties)&#xa;sentinelai.elk.enabled = true&#xa;sentinelai.elk.url = http://localhost:9200&#xa;sentinelai.elk.index = logs-application&#xa;sentinelai.elk.maxLogResults = 50" vertex="1">
          <mxGeometry height="90" width="300" x="290" y="870" as="geometry" />
        </mxCell>
        <mxCell id="ex-handler" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="ElkInvestigationException&#xa;→ GlobalExceptionHandler&#xa;HTTP 503 Service Unavailable" vertex="1">
          <mxGeometry height="70" width="240" x="620" y="870" as="geometry" />
        </mxCell>
        <mxCell id="engine-app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="FastAPI App&#xa;────────────────&#xa;POST /analyze?provider=groq&#xa;Router → provider dispatch&#xa;_to_rca_response() parser" vertex="1">
          <mxGeometry height="120" width="280" x="970" y="70" as="geometry" />
        </mxCell>
        <mxCell id="engine-adapter" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Groq Provider Adapter&#xa;────────────────&#xa;providers_config.json&#xa;model: llama-3.3-70b-versatile&#xa;Parses keys:&#xa;  issue / rootCause /&#xa;  impactedService / recommendedFix" vertex="1">
          <mxGeometry height="150" width="280" x="970" y="260" as="geometry" />
        </mxCell>
        <mxCell id="es" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Elasticsearch 7.17.5&#xa;────────────────&#xa;localhost:9200&#xa;Index: logs-application&#xa;15 seed documents&#xa;(elk-seed-data.bat)" vertex="1">
          <mxGeometry height="160" width="280" x="970" y="490" as="geometry" />
        </mxCell>
        <mxCell id="groq" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Groq Cloud API&#xa;────────────────&#xa;llama-3.3-70b-versatile&#xa;~3 s inference time&#xa;Returns structured JSON:&#xa;  { issue, rootCause,&#xa;    impactedService, recommendedFix }" vertex="1">
          <mxGeometry height="140" width="280" x="970" y="710" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="ui-form" style="endArrow=block;html=1;strokeColor=#6c8ebf;strokeWidth=2;" target="ctrl" value="POST /api/elk-investigation/search">
          <mxGeometry relative="1" x="0.0672" y="-12" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="ctrl" style="endArrow=block;html=1;strokeColor=#82b366;strokeWidth=2;" target="svc" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="svc" style="endArrow=block;html=1;strokeColor=#82b366;" target="elk-client" value="② fetch logs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="elk-client" style="endArrow=block;html=1;strokeColor=#d6b656;strokeWidth=2;" target="es" value="BoolQuery (service + severity + date range)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="es" style="endArrow=block;html=1;strokeColor=#d6b656;dashed=1;" target="elk-client" value="up to 50 log lines">
          <mxGeometry relative="1" x="0.35" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="svc" style="endArrow=block;html=1;strokeColor=#82b366;" target="prompt" value="③ build prompt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="svc" style="endArrow=block;html=1;strokeColor=#82b366;" target="ai-svc" value="④ call AI">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="ai-svc" style="endArrow=block;html=1;strokeColor=#b85450;strokeWidth=2;" target="engine-app" value="POST /analyze?provider=groq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="engine-app" style="endArrow=block;html=1;strokeColor=#b85450;" target="engine-adapter" value="dispatch to groq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="engine-adapter" style="endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=2;" target="groq" value="LLM inference request">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="groq" style="endArrow=block;html=1;strokeColor=#d79b00;dashed=1;" target="engine-adapter" value="{issue, rootCause, impactedService, recommendedFix}">
          <mxGeometry relative="1" x="0.35" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="svc" style="endArrow=block;html=1;strokeColor=#82b366;" target="parser" value="⑤ parse response">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" edge="1" parent="1" source="parser" style="endArrow=block;html=1;strokeColor=#6c8ebf;dashed=1;strokeWidth=2;" target="ui-result" value="ElkInvestigationResponse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" edge="1" parent="1" source="props" style="endArrow=open;html=1;strokeColor=#d6b656;dashed=1;" target="elk-client" value="@ConfigurationProperties">
          <mxGeometry relative="1" as="geometry" />
