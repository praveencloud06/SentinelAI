            <mxPoint x="1" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_vector_ollama" edge="1" parent="1" source="coreVector" style="endArrow=block;html=1;strokeColor=#9673a6;" target="ollama" value="embed() (default)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_core_aie" edge="1" parent="1" source="coreServices" style="endArrow=block;html=1;strokeColor=#b85450;" target="aiEngine" value="POST /analyze?provider=...">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_aie_prov" edge="1" parent="1" source="aiEngine" style="endArrow=block;html=1;strokeColor=#b85450;" target="providers" value="route by provider">
